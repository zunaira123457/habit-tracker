# Copy to .env for local development (npm run serve; vercel dev reads .env). Set the same values
# in the Vercel project (Settings → Environment Variables) for production.

# Anthropic API key, used only by the server functions in api/
ANTHROPIC_API_KEY=

# Passcode the app must send to use the AI endpoints. Enter the same value in
# the app under Settings → Interview Prep. Pick something long and random.
APP_PASSCODE=

# Optional overrides
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Set to 1 to return canned AI responses (no API key needed, no cost)
# MOCK_AI=1
